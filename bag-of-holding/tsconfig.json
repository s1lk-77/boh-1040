{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["bun", "node"],
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@design/*": ["./design/*"]
    }
  },
  "include": [
    "src",
    "web",
    "generated.config.ts",
    "generated",
    "declarations.d.ts",
    "shared"
  ]
}
